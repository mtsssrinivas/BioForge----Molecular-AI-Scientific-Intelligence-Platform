# BioForge Environment Configuration

# Core
PROJECT_NAME="BioForge"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
RANDOM_SEED=42

# API Server
API_V1_STR="/api"
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL & Vector Database
POSTGRES_USER="bioforge_user"
POSTGRES_PASSWORD="bioforge_secure_password"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="bioforge"
DATABASE_URL="postgresql+psycopg2://bioforge_user:bioforge_secure_password@localhost:5432/bioforge"
# Local fallback for development / offline tests:
# DATABASE_URL="sqlite:///./data/bioforge.db"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# RAG & LLM Provider Configuration
LLM_PROVIDER="mock"  # Options: mock, openai, anthropic, ollama
OPENAI_API_KEY=""
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384
